# Required: create a key in Google AI Studio.
GEMINI_API_KEY=replace-me

# Optional secrets referenced in a testing goal as $USERNAME / $PASSWORD.
# These token names, rather than their values, are sent to Gemini.
USERNAME=your-test-user
PASSWORD=your-test-password

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash-lite
HEADLESS=false
MAX_STEPS=25
