# Required: Azure OpenAI / Microsoft Foundry v1 configuration.
# AZURE_OPENAI_ENDPOINT may be the resource root or the full /openai/v1 URL.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
# Azure deployment name (not necessarily the underlying base model name).
AZURE_OPENAI_DEPLOYMENT=your-vision-model-deployment

# `Azure_openai_api_key` is also supported for compatibility, but the
# conventional uppercase AZURE_OPENAI_API_KEY is preferred.
# Azure_openai_api_key=replace-me

# Optional secrets referenced in a testing goal as $USERNAME / $PASSWORD.
# These token names, rather than their values, are sent to Azure OpenAI.
USERNAME=your-test-user
PASSWORD=your-test-password

# Optional overrides
# AZURE_OPENAI_MODEL can be used instead of AZURE_OPENAI_DEPLOYMENT.
HEADLESS=false
MAX_STEPS=25
